# 复制为 .env 后填写真实值：cp .env.example .env
# 本地开发：backend 服务在宿主机运行时，使用 localhost 连接；docker compose 内使用 db 主机名。

# --- 数据库 ---
# 宿主机直接运行后端（配合 `docker compose up -d db`）：
DATABASE_URL=postgresql+asyncpg://ccn:ccn_password@localhost:5432/continuum_care
# docker compose 内 backend 服务使用（compose 会覆盖）：
# DATABASE_URL=postgresql+asyncpg://ccn:ccn_password@db:5432/continuum_care

# --- JWT ---
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- 运行环境 ---
# development: 启动时自动建表 + 种子管理员；production: 必须先用 alembic upgrade head
ENV=development

# --- 种子管理员（仅首次启动创建）---
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=Admin123456

# --- 服务端口 ---
WEB_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
