# ============================================================
# Continuum-Care-Network 生产环境变量模板
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   # 然后逐项替换为真实值（生产环境禁止使用示例默认值）
#   docker compose --env-file deploy/.env up -d --build
#
# 生成强随机值参考：
#   openssl rand -hex 32      # JWT_SECRET
#   openssl rand -hex 24      # POSTGRES_PASSWORD / SEED_ADMIN_PASSWORD
# ============================================================

# ---------- 运行环境 ----------
# production：启动时执行 alembic 迁移（compose command 已内置），不自动建表
# development：lifespan 自动 create_all + 种子管理员（仅本地调试用）
ENV=production

# ---------- 数据库（单点定义，compose 会同时用于 db 与 backend） ----------
POSTGRES_USER=ccn
POSTGRES_PASSWORD=<替换为强密码>
POSTGRES_DB=continuum_care
# 容器时区（可选，默认 UTC）
# TZ=Asia/Shanghai

# ---------- JWT（必须替换！至少 32 字节随机值） ----------
JWT_SECRET=<替换为随机密钥>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS（生产改为真实前端域名，多个来源用逗号分隔） ----------
CORS_ORIGINS=https://app.example.com

# ---------- 前端（构建期内联到浏览器 JS） ----------
# 必须是浏览器可访问的 API 地址（含 /api/v1 前缀）
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# ---------- 种子管理员（仅首次启动创建，创建后建议改密） ----------
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=<替换为强密码>

# ---------- 服务端口（宿主机映射） ----------
WEB_PORT=3000
BACKEND_PORT=8000
# 生产建议改为仅本机监听：DB_PORT=127.0.0.1:5432
DB_PORT=5432

# ---------- 可选：镜像 tag 与 uvicorn worker 数 ----------
# IMAGE_TAG=20260803-1
# UVICORN_WORKERS=2
